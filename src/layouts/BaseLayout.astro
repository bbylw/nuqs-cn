---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "nuqs — 类型安全的 React URL 搜索参数状态管理器",
  description = "nuqs 是面向 React 各类框架的类型安全搜索参数状态管理器。用法类似 useState，但状态存储在 URL 查询字符串中。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content="/og.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script>
      // ---- 复制按钮（事件委托） ----
      document.addEventListener("click", async (event) => {
        const target = event.target as HTMLElement | null;
        const btn = target?.closest<HTMLButtonElement>("[data-copy-btn]");
        if (!btn) return;
        const text =
          btn.dataset.copy ??
          btn.closest("figure")?.querySelector("pre code")?.textContent ??
          "";
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          return;
        }
        btn.dataset.copied = "true";
        const label = btn.querySelector<HTMLElement>("[data-copy-label]");
        if (label) label.textContent = "已复制";
        window.setTimeout(() => {
          delete btn.dataset.copied;
          if (label) label.textContent = "复制";
        }, 1600);
      });

      // ---- 标签页（事件委托） ----
      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        const btn = target?.closest<HTMLButtonElement>("[data-tab-btn]");
        if (!btn) return;
        const group = btn.closest("[data-tabs]");
        if (!group) return;
        const id = btn.dataset.tabBtn;
        if (!id) return;
        group
          .querySelectorAll<HTMLButtonElement>("[data-tab-btn]")
          .forEach((el) => {
            el.dataset.active = String(el === btn);
            el.setAttribute("aria-selected", String(el === btn));
            el.tabIndex = el === btn ? 0 : -1;
          });
        group.querySelectorAll<HTMLElement>("[data-tab-panel]").forEach((el) => {
          el.hidden = el.dataset.tabPanel !== id;
        });
      });

      // ---- 标签页（方向键导航） ----
      document.addEventListener("keydown", (event) => {
        const target = event.target as HTMLElement | null;
        const btn = target?.closest<HTMLButtonElement>("[data-tab-btn]");
        if (!btn) return;
        const group = btn.closest("[data-tabs]");
        if (!group) return;
        const btns = Array.from(
          group.querySelectorAll<HTMLButtonElement>("[data-tab-btn]"),
        );
        const index = btns.indexOf(btn);
        if (index === -1) return;
        let next: number;
        switch (event.key) {
          case "ArrowLeft":
            next = (index - 1 + btns.length) % btns.length;
            break;
          case "ArrowRight":
            next = (index + 1) % btns.length;
            break;
          case "Home":
            next = 0;
            break;
          case "End":
            next = btns.length - 1;
            break;
          default:
            return;
        }
        event.preventDefault();
        btns[next]?.focus();
        btns[next]?.click();
      });

      // ---- 滚动显现 ----
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduced) {
        revealEls.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        revealEls.forEach((el) => io.observe(el));
      }
    </script>
  </head>
  <body class="min-h-[100dvh] bg-ink-900 text-fog-200 antialiased">
    <!-- 氛围层：网格 + 荧光晕 -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"
    >
      <div
        class="bg-blueprint fade-edges absolute inset-x-0 top-0 h-[110vh] opacity-70"
      >
      </div>
      <div
        class="glow-signal absolute -top-40 left-1/4 h-[560px] w-[560px] rounded-full blur-3xl"
      >
      </div>
      <div
        class="glow-signal absolute top-[45%] right-[-10%] h-[620px] w-[620px] rounded-full opacity-60 blur-3xl"
      >
      </div>
    </div>

    <SiteHeader />
    <TableOfContents />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
