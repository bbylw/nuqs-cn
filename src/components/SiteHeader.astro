---
import { sections } from "../data/sections";

const navLinks = sections.filter((s) =>
  ["features", "install", "adapters", "usage", "parsing", "options", "testing"].includes(s.id),
);
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-ink-900/85 backdrop-blur-xl"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-6">
    <a href="#top" class="group flex items-center gap-2" aria-label="nuqs 首页">
      <span class="font-display text-2xl font-bold leading-none text-signal transition-transform duration-300 group-hover:-rotate-12"
        >?</span
      >
      <span class="font-display text-lg font-semibold tracking-tight text-fog-50"
        >nuqs</span
      >
      <span
        class="ml-1 rounded border border-line px-1.5 py-0.5 font-mono text-[10px] leading-none text-fog-400"
        >v2.10.2</span
      >
    </a>

    <nav class="hidden items-center gap-0.5 md:flex" aria-label="页面导航">
      {
        navLinks.map((link) => (
          <a
            href={`#${link.id}`}
            class="rounded px-2.5 py-1.5 font-mono text-xs text-fog-400 transition-colors duration-200 hover:bg-ink-800 hover:text-signal"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/47ng/nuqs"
        target="_blank"
        rel="noreferrer noopener"
        class="flex items-center gap-2 rounded border border-line px-3 py-1.5 font-mono text-xs text-fog-300 transition-colors duration-200 hover:border-signal/50 hover:text-signal"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4 fill-current" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.05-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.13 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        GitHub
      </a>

      <details class="relative md:hidden">
        <summary
          class="flex h-8 w-8 cursor-pointer list-none items-center justify-center rounded border border-line text-fog-300 [&::-webkit-details-marker]:hidden"
          aria-label="打开菜单"
        >
          <svg viewBox="0 0 16 16" class="h-4 w-4 stroke-current" fill="none" stroke-width="1.5">
            <path d="M2 4h12M2 8h12M2 12h12" stroke-linecap="round"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 top-11 w-44 border border-line bg-ink-850 p-1.5 shadow-2xl shadow-black/50"
        >
          {
            navLinks.map((link) => (
              <a
                href={`#${link.id}`}
                class="block rounded px-3 py-2 font-mono text-xs text-fog-300 hover:bg-ink-800 hover:text-signal"
              >
                <span class="mr-2 text-fog-500">{link.num}</span>{link.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</header>
