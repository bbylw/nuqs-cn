---
const year = new Date().getFullYear();

const resourceLinks = [
  { label: "nuqs.dev 官方文档", href: "https://nuqs.dev" },
  { label: "GitHub 仓库", href: "https://github.com/47ng/nuqs" },
  { label: "npm 包", href: "https://www.npmjs.com/package/nuqs" },
  { label: "MIT 许可证", href: "https://github.com/47ng/nuqs/blob/next/LICENSE" },
];

const communityLinks = [
  { label: "提交 Issue", href: "https://github.com/47ng/nuqs/issues" },
  { label: "贡献者", href: "https://github.com/47ng/nuqs/graphs/contributors" },
  { label: "GitHub Sponsors", href: "https://github.com/sponsors/franky47" },
  { label: "François Best", href: "https://francoisbest.com" },
];
---

<footer class="relative mt-24 border-t border-line/60 bg-ink-950/70">
  <div class="mx-auto max-w-5xl px-5 pt-16 pb-10 sm:px-6">
    <!-- 品牌区 + 链接区 -->
    <div class="flex flex-col gap-12 border-b border-line-soft pb-12 lg:flex-row lg:justify-between">
      <div class="max-w-md">
        <p class="font-display text-4xl font-bold leading-none tracking-tighter text-fog-50 sm:text-5xl">
          <span class="text-signal">?</span>nuqs
        </p>
        <p class="mt-4 text-sm leading-relaxed text-fog-400">
          面向 React 各类框架的、类型安全的搜索参数状态管理器。<br />
          用法类似 <code class="font-mono text-fog-200">useState</code>，但状态存储在 URL 查询字符串中。
        </p>
      </div>

      <div class="flex gap-12 sm:gap-16">
        <div>
          <p class="label-mono mb-4">资源</p>
          <ul class="space-y-2.5">
            {
              resourceLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    rel="noreferrer noopener"
                    class="group inline-flex items-center gap-1 text-sm text-fog-400 transition-colors hover:text-signal"
                  >
                    {l.label}
                    <svg viewBox="0 0 12 12" class="h-3 w-3 stroke-current opacity-50 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke-width="1.5">
                      <path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="label-mono mb-4">社区</p>
          <ul class="space-y-2.5">
            {
              communityLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    rel="noreferrer noopener"
                    class="group inline-flex items-center gap-1 text-sm text-fog-400 transition-colors hover:text-signal"
                  >
                    {l.label}
                    <svg viewBox="0 0 12 12" class="h-3 w-3 stroke-current opacity-50 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke-width="1.5">
                      <path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- 底栏 -->
    <div class="flex flex-col gap-4 pt-8 text-xs text-fog-500 sm:flex-row sm:items-center sm:justify-between">
      <p>
        非官方中文站点 · 内容译自 <a href="https://github.com/47ng/nuqs#readme" rel="noreferrer noopener" class="text-fog-300 underline decoration-line underline-offset-4 transition-colors hover:text-signal hover:decoration-signal">官方 README</a> 与
        <a href="https://nuqs.dev" rel="noreferrer noopener" class="text-fog-300 underline decoration-line underline-offset-4 transition-colors hover:text-signal hover:decoration-signal">nuqs.dev</a>
      </p>
      <div class="flex items-center gap-5">
        <p class="font-mono">MIT © {year} nuqs contributors</p>
        <a
          href="#top"
          class="group inline-flex items-center gap-1.5 rounded border border-line px-3 py-1.5 font-mono text-xs text-fog-300 transition-all duration-200 hover:-translate-y-0.5 hover:border-signal/40 hover:text-signal hover:shadow-lg hover:shadow-black/30 active:scale-[0.98]"
        >
          回到顶部
          <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 stroke-current transition-transform duration-300 group-hover:-translate-y-0.5" fill="none" stroke-width="1.5">
            <path d="M8 13V3m0 0L3.5 7.5M8 3l4.5 4.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
