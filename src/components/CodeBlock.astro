---
import { Code } from "astro/components";

type CodeLang = "ts" | "tsx" | "js" | "bash";

interface Props {
  code: string;
  lang?: CodeLang;
  file?: string;
  class?: string;
  /** 双栏并排时限制代码块高度，避免左右失衡 */
  maxH?: string;
  /** 双栏并排时使用更紧凑的字号，尽量避免横向溢出 */
  dense?: boolean;
}

const { code, lang = "tsx", file, class: className = "", maxH, dense = false } = Astro.props;
---

<figure
  class={`group/code relative overflow-hidden rounded-xl border border-line bg-ink-850/90 ${className}`}
>
  <figcaption
    class="flex items-center justify-between gap-4 border-b border-line/80 bg-ink-800/40 px-4 py-2"
  >
    <span class="truncate font-mono text-[11px] text-fog-400">
      {file ?? lang}
    </span>
    <button
      type="button"
      data-copy-btn
      class="flex shrink-0 items-center gap-1.5 rounded font-mono text-[11px] text-fog-400 transition-colors duration-200 hover:text-signal data-[copied=true]:text-signal"
      aria-label="复制代码"
    >
      <svg viewBox="0 0 14 14" class="h-3.5 w-3.5 stroke-current" fill="none" stroke-width="1.3">
        <rect x="4.5" y="4.5" width="8" height="8" rx="1.5"></rect>
        <path d="M9.5 4.5v-2a1 1 0 0 0-1-1H3.5a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1h2" stroke-linecap="round"></path>
      </svg>
      <span data-copy-label>复制</span>
    </button>
  </figcaption>
  <div class:list={["overflow-x-auto overflow-y-auto", dense && "code-dense"]} style={maxH ? `max-height:${maxH}` : undefined}>
    <Code code={code} lang={lang} />
  </div>
</figure>
